{
  "name": "root",
  "private": true,
  "description": "Library for NLU (Natural Language Understanding) done in Node.js",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "ci:publish": "turbo run build && changeset publish",
    "coveralls": "vitest run --coverage && cat ./coverage/lcov.info | coveralls",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lintfix": "oxlint --fix",
    "test": "oxfmt && oxlint --fix && vitest run --silent --coverage"
  },
  "author": {
    "email": "opensource@axa.com",
    "name": "Jesus Seijas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axa-group/nlp.js.git"
  },
  "bugs": {
    "url": "https://github.com/axa-group/nlp.js/issues"
  },
  "homepage": "https://github.com/axa-group/nlp.js#readme",
  "maintainers": [
    {
      "email": "opensource@axa.com",
      "name": "Jesus Seijas"
    },
    {
      "name": "Igor Savin",
      "email": "kibertoad@gmail.com",
      "url": "https://github.com/kibertoad"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "coveralls": "^3.1.0",
    "https-proxy-agent": "^5.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "supertest": "^6.1.3",
    "turbo": "^2.11.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
