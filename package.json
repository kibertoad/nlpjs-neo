{
  "name": "root",
  "private": true,
  "description": "Library for NLU (Natural Language Understanding) done in Node.js",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "changeset": "changeset",
    "check:exports": "node scripts/check-package-exports.mjs",
    "ci:publish": "pnpm run build && changeset publish",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lintfix": "oxlint --fix",
    "test": "oxfmt && oxlint --fix && vitest run --silent --coverage",
    "typecheck": "tsc --build && tsc --project tsconfig.test.json"
  },
  "author": {
    "name": "Igor Savin",
    "email": "kibertoad@gmail.com",
    "url": "https://github.com/kibertoad"
  },
  "contributors": [
    {
      "name": "Jesus Seijas",
      "email": "opensource@axa.com",
      "url": "https://github.com/axa-group/nlp.js"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/nlpjs-neo.git"
  },
  "bugs": {
    "url": "https://github.com/kibertoad/nlpjs-neo/issues"
  },
  "homepage": "https://github.com/kibertoad/nlpjs-neo#readme",
  "maintainers": [
    {
      "name": "Igor Savin",
      "email": "kibertoad@gmail.com",
      "url": "https://github.com/kibertoad"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
