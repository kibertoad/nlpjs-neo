{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "vitest",
    "node"
  ],
  "env": {
    "builtin": true,
    "node": true,
    "es2022": true,
    "vitest": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-await-in-loop": "off",
    "no-misleading-character-class": "off",
    "vitest/expect-expect": "off",
    "vitest/no-commented-out-tests": "off"
  },
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "docs/v3/static/scripts/**",
    "packages/python-compiler/src/python-executer.ts",
    "packages/express-api-server/public/**",
    "examples/07-nlpjs-on-aws-lambda/**",
    "examples/16-fb-connector/**",
    "**/*BAK*"
  ],
  "overrides": [
    {
      "files": [
        "examples/**/*.js"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
