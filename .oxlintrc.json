{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "typescript",
    "vitest",
    "node"
  ],
  "env": {
    "builtin": true,
    "node": true,
    "es2022": true,
    "vitest": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    // The generated Snowball stemmers used to sit behind a blanket disable
    // and are now held to these, so they stay in the code style of the rest.
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "curly": "error",
    "no-await-in-loop": "off",
    "no-misleading-character-class": "off",
    "vitest/expect-expect": "off",
    "vitest/no-commented-out-tests": "off",
    // The conversion from JavaScript is done: every package states its types.
    // A value whose type really is not known belongs in `unknown`, and the
    // few places where neither will do carry a disable comment saying why.
    "typescript/no-explicit-any": "error",
    // `NlpUtil`, `XTableUtils` and `Handlebars` are static-only classes of
    // the published API, so they stay classes until a major version.
    "typescript/no-extraneous-class": "off"
  },
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "docs/v3/static/scripts/**",
    "**/*BAK*"
  ],
  "overrides": [
    {
      "files": [
        "examples/**/*.js"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
